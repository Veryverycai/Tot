{
  "name": "tot",
  "productName": "Tot",
  "version": "1.2.1",
  "description": "Tot — Trail of Tears：本地 Markdown 文件浏览器",
  "author": "Tot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tot.browser",
    "productName": "Tot",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib/**/*",
      "icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh"
    }
  }
}
